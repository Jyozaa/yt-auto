TTS_PROVIDER=kokoro
KOKORO_VOICE=am_fenrir
# Optional override. Connected phrasing defaults to 1.04 and sentence mode to 1.07.
KOKORO_SPEED=
VOICE_PROCESSING=minimal
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
VOICE_FILE=
WORDS_FILE=
MUSIC_GAIN=0.20
MUSIC_DUCK=0.52
SFX_GAIN=0.31
PREVIEW_WIDTH=360
FINAL_WIDTH=1080
QA_REPAIR_ATTEMPTS=1
STORY_TRUSTED_AUTHORS=Jyozaa
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_ALLOW_PUBLIC=false
# Optional: RENDER_CONCURRENCY, RENDER_MSAA, RENDER_GL, CHROME_PATH, REMOTION_TMP, PYTHON
# Optional: VOICE_MODEL_DIR, ESPEAK_LIBRARY, ESPEAK_DATA_PARENT, VISION_ENDPOINT, STORY_REVIEW_ENDPOINT
# Store ELEVENLABS_API_KEY, VISION_API_KEY, STORY_REVIEW_API_KEY and YouTube OAuth values in GitHub Actions secrets.
