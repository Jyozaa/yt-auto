    "youtube:upload": "tsx scripts/queue.ts finish",
    "audio": "tsx scripts/audio.ts",
    "audit": "tsx scripts/audit.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "visual:stills": "tsx scripts/visual-stills.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544",
    "three": "0.179.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.179.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
